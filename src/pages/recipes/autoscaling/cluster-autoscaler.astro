---
// Merged into the recipe at `to`. Title and description are that recipe's
// frontmatter, so the stub has an H1 and a meta description while it redirects.
const to = "/recipes/autoscaling/kubernetes-cluster-autoscaler-configuration/";
const title = "Kubernetes Cluster Autoscaler: Setup and Tuning";
const description = "Install and tune Kubernetes Cluster Autoscaler on EKS, GKE and AKS: scale-down flags, expanders, max-node-provision-time, GPU scale-to-zero.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://kubernetes.recipes${to}`} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to }}>window.location.replace(to);</script>
  </head>
  <body>
    <h1>{title}</h1>
    <p>{description}</p>
    <p>This recipe has moved to <a href={to}>{title}</a>.</p>
  </body>
</html>
