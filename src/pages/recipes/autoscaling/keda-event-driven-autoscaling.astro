---
// Merged into the recipe at `to`. Title and description are that recipe's
// frontmatter, so the stub has an H1 and a meta description while it redirects.
const to = "/recipes/autoscaling/kubernetes-keda-event-driven-autoscaling/";
const title = "KEDA: Event-Driven Autoscaling for Kubernetes";
const description = "Install KEDA with Helm and scale on Kafka lag, RabbitMQ, Prometheus, cron or HTTP. ScaledObject, ScaledJob, TriggerAuthentication, scale-to-zero.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://kubernetes.recipes${to}`} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to }}>window.location.replace(to);</script>
  </head>
  <body>
    <h1>{title}</h1>
    <p>{description}</p>
    <p>This recipe has moved to <a href={to}>{title}</a>.</p>
  </body>
</html>
