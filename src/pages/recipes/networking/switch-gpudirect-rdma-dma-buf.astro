---
// Merged into the recipe at `to`. Title and description are that recipe's
// frontmatter, so the stub has an H1 and a meta description while it redirects.
const to = "/recipes/ai/nvidia-peermem-gpudirect-rdma-k8s/";
const title = "Fix modprobe nvidia_peermem Invalid Argument";
const description = "nvidia-peermem won't load or ib_register_peer_memory_client is missing? Fix GPUDirect RDMA on Kubernetes: MOFED load order, GPU Operator settings, or DMA-BUF.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://kubernetes.recipes${to}`} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to }}>window.location.replace(to);</script>
  </head>
  <body>
    <h1>{title}</h1>
    <p>{description}</p>
    <p>This recipe has moved to <a href={to}>{title}</a>.</p>
  </body>
</html>
