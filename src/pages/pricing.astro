---
// "Get the book": where to buy Kubernetes Recipes and the free sample chapter.
// It replaced the Astroship pricing template (Personal / Startup / Enterprise
// tiers), which was live at this URL. The site has no other book page (the
// homepage is the recipe hub), so the URL stays and now holds the book.
// Book facts and links: src/utils/apress-book.mjs (the card: apress-book-card.astro).
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import ApressBookCard from "@components/apress-book-card.astro";
---

<Layout
  title="Get the Book"
  description="Get Kubernetes Recipes (Apress), the practical guide to container orchestration: paperback and eBook from Amazon and Springer Nature, plus a free Chapter 7 sample."
>
  <Container>
    <Sectionhead>
      <Fragment slot="title">Get the Book</Fragment>
      <Fragment slot="desc">
        <em>Kubernetes Recipes: A Practical Guide for Container Orchestration and Deployment</em>, published by Apress.
      </Fragment>
    </Sectionhead>

    <ApressBookCard
      class="mx-auto mt-12 max-w-4xl"
      placement="pricing"
      size="lg"
      as="h2"
      cta="Buy on Amazon"
      showSpringer
      loading="eager"
      blurb="Paperback and eBook, from Amazon or from Springer Nature, the publisher's store."
    />

    <div class="mx-auto mt-12 grid max-w-4xl gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-semibold text-slate-900">Read a chapter first</h2>
        <p class="mt-2 text-slate-700 leading-relaxed">
          Chapter 7, on Kubernetes storage, is free. Download it from the
          <a href="/chapters/" class="text-blue-600 underline underline-offset-2">chapters page</a>, which also lists what every chapter covers.
        </p>
        <p class="mt-6 text-slate-700">
          The free recipes on this site are in the <a href="/recipes/" class="text-blue-600 underline underline-offset-2">recipe collection</a>.
        </p>
      </div>
      <div>
        <h2 class="text-2xl font-semibold text-slate-900">Book details</h2>
        <dl class="mt-3 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm text-slate-600">
          <dt class="font-semibold">ISBN-13</dt><dd>979-8-8688-1324-5</dd>
          <dt class="font-semibold">Publisher</dt><dd>Apress; First Edition (April 1, 2025)</dd>
          <dt class="font-semibold">Language</dt><dd>English</dd>
          <dt class="font-semibold">Paperback</dt><dd>750 pages</dd>
        </dl>
      </div>
    </div>
  </Container>
</Layout>
