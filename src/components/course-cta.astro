---
/**
 * Contextual course recommendations based on recipe category/tags.
 * Links to CopyPasteLearn.com courses.
 *
 * Recipes with a matching video course (AI, agents, model serving,
 * observability: src/utils/copypastelearn.mjs) show ONE card for that course
 * instead of the general block below, so a recipe never carries two
 * CopyPasteLearn cards. Every other recipe keeps the general block.
 *
 * The general block links only courses whose free lesson has video. The MLflow
 * and Terraform courses do not, so their places are taken by "MLOps on Your
 * Mac" and "Kubernetes on your Mac" (data in copypastelearn.mjs).
 */
import { COPYPASTELEARN_COURSES, copyPasteLearnCourseFor, copyPasteLearnUrl } from "../utils/copypastelearn.mjs";

export interface Props {
  category?: string;
  tags?: string[];
  slug?: string;
}

const { category = "", tags = [], slug = "" } = Astro.props;

const videoCourse = copyPasteLearnCourseFor({ category, tags });
// One string, so the HTML minifier cannot drop the spaces between the parts.
const videoCourseText = videoCourse
  ? `${videoCourse.description} ${videoCourse.format} The first lesson is free, no signup required.`
  : "";

const allTags = tags.map(t => t.toLowerCase());
const cat = category.toLowerCase();
const s = slug.toLowerCase();

// Determine which courses are relevant
interface Course {
  key: string;
  url: string;
  title: string;
  description: string;
  emoji: string;
}

const courses: Course[] = [];

// A general-block card for a course in copypastelearn.mjs. The key is also the
// utm_content value and the data-cpl-course attribute.
const catalog = COPYPASTELEARN_COURSES as Record<string, { title: string; description: string; path: string }>;
const catalogCourse = (key: string, emoji: string): Course => ({
  key,
  url: copyPasteLearnUrl(catalog[key].path, key),
  title: catalog[key].title,
  description: catalog[key].description,
  emoji,
});

// MLOps course — for AI, ML, training, inference recipes
if (cat === "ai" || allTags.some(t => ["mlflow", "mlops", "training", "inference", "gpu", "distributed-training", "fine-tuning", "llm"].includes(t))) {
  courses.push(catalogCourse("mlops-mac", "🧪"));
}

// Kubernetes on your Mac course — for infrastructure, cluster setup, cloud recipes
if (allTags.some(t => ["terraform", "infrastructure", "iac", "cluster-setup", "cloud", "eks", "gke", "aks"].includes(t)) || s.includes("terraform")) {
  courses.push(catalogCourse("kubernetes-mac", "☸️"));
}

// Ansible course — for configuration, automation, deployment recipes
if (allTags.some(t => ["ansible", "automation", "configuration-management"].includes(t)) || cat === "configuration" || s.includes("ansible")) {
  courses.push({
    key: "ansible",
    url: copyPasteLearnUrl("/courses/ansible-quickstart", "ansible"),
    title: "Ansible Quickstart",
    description: "Automate Kubernetes node configuration and cluster bootstrapping with Ansible.",
    emoji: "⚡",
  });
}

// If no specific match, show a general selection (max 2)
if (courses.length === 0) {
  // Kubernetes on your Mac for cluster-adjacent, Ansible for operations-adjacent
  if (["autoscaling", "observability", "networking"].includes(cat)) {
    courses.push(catalogCourse("kubernetes-mac", "☸️"));
  }
  if (["security", "storage", "deployments", "helm"].includes(cat)) {
    courses.push({
      key: "ansible",
    url: copyPasteLearnUrl("/courses/ansible-quickstart", "ansible"),
      title: "Ansible Quickstart",
      description: "Automate cluster bootstrapping and node configuration with Ansible.",
      emoji: "⚡",
    });
  }
}

// Limit to 2 courses max. None when the recipe has its own video course card.
const displayCourses = videoCourse ? [] : courses.slice(0, 2);
---

{videoCourse && (
  <aside class="mt-8 mb-4 not-prose" aria-label="Video course on CopyPasteLearn" data-cpl-course={videoCourse.key} data-cpl-placement="video-course">
    <div class="bg-gradient-to-r from-slate-50 to-blue-50 border border-slate-200 rounded-xl p-6">
      <p class="text-xs uppercase tracking-wider text-slate-600 font-semibold mb-2">
        🎓 Video course by Luca Berton on CopyPasteLearn
      </p>
      <p class="text-lg font-bold text-slate-900">{videoCourse.title}</p>
      <p class="text-sm text-slate-700 mt-2 leading-relaxed">{videoCourseText}</p>
      <div class="mt-4">
        <a
          href={videoCourse.url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition-colors"
        >
          Start the free lesson →
        </a>
      </div>
    </div>
  </aside>
)}

{displayCourses.length > 0 && (
  <div class="mt-8 mb-4 not-prose">
    <div class="bg-gradient-to-r from-slate-50 to-blue-50 border border-slate-200 rounded-xl p-6">
      <p class="text-xs uppercase tracking-wider text-slate-600 font-semibold mb-3">
        🎓 Deepen Your Skills — Hands-on Courses
      </p>
      <div class={`grid gap-3 ${displayCourses.length > 1 ? 'md:grid-cols-2' : ''}`}>
        {displayCourses.map((course) => (
          <a 
            href={course.url}
            target="_blank"
            rel="noopener"
            data-cpl-course={course.key}
            data-cpl-placement="general-block"
            class="flex items-start gap-3 bg-white rounded-lg p-4 border border-slate-100 hover:border-blue-300 hover:shadow-md transition-all group"
          >
            <span class="text-2xl">{course.emoji}</span>
            <div>
              <span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">
                {course.title}
              </span>
              <p class="text-sm text-slate-500 mt-1">{course.description}</p>
              <span class="text-xs text-blue-600 font-medium mt-2 inline-block">
                Start Learning →
              </span>
            </div>
          </a>
        ))}
      </div>
      <p class="text-xs text-slate-600 mt-3 text-center">
        Courses by <a href={copyPasteLearnUrl("/", "general-block")} target="_blank" rel="noopener" data-cpl-course="home" data-cpl-placement="general-block" class="underline hover:text-blue-500">CopyPasteLearn.com</a> — Learn IT by Doing
      </p>
    </div>
  </div>
)}
