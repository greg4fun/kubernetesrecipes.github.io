---
import { Picture } from "astro:assets";
import heroImage from "assets/KubernetesReceipes.webp";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";
import { APRESS_BOOK as BOOK } from "../utils/apress-book.mjs";

const pills = ["Paperback · eBook", BOOK.publisher, `${BOOK.pages} pages`];
---

<main class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <!-- Text Container -->
  <div class="order-1 md:order-2">
    <p class="text-xs font-semibold uppercase tracking-wider text-blue-700">{`Book by ${BOOK.authors}`}</p>
    <h1 class="mt-2 text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Kubernetes Recipes
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      A Practical Guide for Container Orchestration and Deployment.
    </p>
    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Book details">
      {pills.map((pill) => (
        <li class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-800">{pill}</li>
      ))}
    </ul>

    <!-- Buy Links -->
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        href={BOOK.amazon}
        target="_blank"
        class="flex min-h-11 gap-1 items-center justify-center"
        data-book={BOOK.slug}
        data-book-placement="home-hero"
        rel="sponsored noopener">
        <Icon class="text-white w-5 h-5" name="bx:bxs-book" />
         Buy Now on Amazon
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href={BOOK.springer}
        class="flex min-h-11 gap-1 items-center justify-center"
        data-book={BOOK.slug}
        data-book-placement="home-hero"
        target="_blank">
        <Icon class="text-black w-4 h-4" name="bx:bx-book-reader" />
         Springer Nature
      </Link>
    </div>

    <!-- Book Details -->
    <div class="mt-8 text-sm text-slate-500 space-y-1">
      <p><strong>ISBN-13:</strong> 979-8-8688-1324-5</p>
      <p><strong>Publisher:</strong> Apress; First Edition (April 1, 2025)</p>
      <p><strong>Language:</strong> English</p>
      <p><strong>Paperback:</strong> 750 pages</p>
      <p><strong>Item Weight:</strong> 1.11 pounds</p>
      <p><strong>Dimensions:</strong> 6.1 x 1.65 x 9.25 inches</p>
    </div>
  </div>

  <!-- Image Container: the cover drawn as a book (spine edge, layered shadow, hover lift) -->
  <div class="py-6 order-2 md:order-1 block">
    <div class="group relative mx-auto w-[240px] sm:w-[300px] lg:w-[340px]">
      <div aria-hidden="true" class="pointer-events-none absolute -inset-10 rounded-full bg-blue-200/50 blur-3xl"></div>
      <div class="relative transition-transform duration-300 ease-out group-hover:-translate-y-1 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0">
        <Picture
          src={heroImage}
          alt={`Cover of ${BOOK.title}`}
          widths={[240, 340, 480, 680]}
          sizes="(max-width: 640px) 240px, (max-width: 1024px) 300px, 340px"
          loading="eager"
          format="avif"
          class="block h-auto w-full rounded-[4px_10px_10px_4px] shadow-[0_2px_2px_rgba(15,23,42,0.08),0_10px_24px_-6px_rgba(15,23,42,0.28),0_36px_60px_-24px_rgba(29,78,216,0.55)]"
        />
        <span aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 w-[6%] rounded-l-[4px] bg-gradient-to-r from-black/35 via-white/25 to-transparent"></span>
        <span aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[4px_10px_10px_4px] ring-1 ring-inset ring-black/10"></span>
      </div>
    </div>
  </div>
</main>
