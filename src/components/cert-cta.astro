---
/**
 * Linux Foundation certification box at the end of a recipe.
 *
 * Kubernetes readers are the people who sit the CKA, CKAD and CKS, so each
 * recipe category points to the exam that tests the same skills. Links go
 * through the Awin affiliate programme (Linux Foundation, merchant 85919):
 * the site earns a commission on purchases, so the box carries a disclosure
 * and rel="sponsored". AI/GPU recipes get the box below instead: no LF exam
 * matches them.
 *
 * Clicks fire the GA4 event affiliate_click (see Layout.astro).
 *
 * OpenShift recipes (src/utils/openshift.mjs: slug, title or tags) show the
 * Open Empower OpenShift upgrade review instead, whatever their category. That
 * link is our own offer, so it has no data-affiliate and no rel="sponsored";
 * its clicks fire enterprise_cta_click (offer, placement). OpenShift recipes
 * about AI/GPU workloads add a compact book card for the OpenShift AI ebook
 * on Leanpub under it.
 *
 * Other AI/GPU recipes (src/utils/ai-gpu.mjs) show two of Luca's own offers:
 * the Kubernetes AI ebook on Leanpub (book_click: book, placement), a book card
 * with its cover, and the GPU cluster design review (enterprise_cta_click:
 * offer, placement), a dark card with an icon; side by side from md up. Order of
 * precedence and the matching rules: src/utils/ai-gpu.mjs.
 */
import { OPENSHIFT_REVIEW, isOpenShiftRecipe, openShiftReviewUrl } from "../utils/openshift.mjs";
import {
  GPU_REVIEW,
  LEANPUB_BOOKS,
  gpuReviewUrl,
  isAiGpuRecipe,
  isOpenShiftAiRecipe,
  leanpubTeamUrl,
  leanpubUrl,
} from "../utils/ai-gpu.mjs";
import BookCover from "./book-cover.astro";

export interface Props {
  category?: string;
  slug?: string;
  title?: string;
  tags?: string[];
}

const { category = "", slug = "", title = "", tags = [] } = Astro.props;

const recipe = { category, slug, title, tags };
const openshift = isOpenShiftRecipe(recipe);
const openshiftAi = openshift && isOpenShiftAiRecipe(recipe);
const aiGpu = !openshift && isAiGpuRecipe(recipe);
const k8sAi = LEANPUB_BOOKS["kubernetes-ai"];
const ocpAi = LEANPUB_BOOKS["openshift-ai"];
const reviewUrl = openShiftReviewUrl(slug);
// One string, so the HTML minifier cannot drop the spaces between the parts.
const reviewText = `A fixed-price ${OPENSHIFT_REVIEW.price} engagement by Open Empower: a written review of your cluster and upgrade path, plus a 90-minute call to go through it with your team.`;

const AWIN = "https://www.awin1.com/cread.php?awinmid=85919&awinaffid=1937397&ued=";
const lf = (path: string) =>
  AWIN + encodeURIComponent(`https://training.linuxfoundation.org/certification/${path}/`);

interface Cert {
  id: string;
  name: string;
  short: string;
  url: string;
}

const CKA: Cert = { id: "cka", name: "Certified Kubernetes Administrator", short: "CKA", url: lf("certified-kubernetes-administrator-cka") };
const CKAD: Cert = { id: "ckad", name: "Certified Kubernetes Application Developer", short: "CKAD", url: lf("certified-kubernetes-application-developer-ckad") };
const CKS: Cert = { id: "cks", name: "Certified Kubernetes Security Specialist", short: "CKS", url: lf("certified-kubernetes-security-specialist") };

interface Pitch {
  cert: Cert;
  line: string;
  also?: Cert;
  note?: string;
}

const PITCH: Record<string, Pitch> = {
  troubleshooting: { cert: CKA, line: "Fixing a broken cluster under time pressure is exactly what the CKA tests, along with networking, storage and cluster configuration." },
  networking: { cert: CKA, line: "Services, ingress, DNS and network policies are core CKA skills, along with troubleshooting, storage and cluster configuration." },
  storage: { cert: CKA, line: "Persistent volumes, claims and storage classes are part of the CKA, along with troubleshooting, networking and cluster configuration." },
  configuration: { cert: CKA, line: "Cluster configuration, workloads and troubleshooting from the command line are what the CKA tests." },
  autoscaling: { cert: CKA, line: "Scheduling, scaling and keeping workloads healthy are part of the CKA, along with troubleshooting and networking." },
  observability: { cert: CKA, line: "Reading logs, events and metrics to find a fault is a large part of the CKA's troubleshooting tasks." },
  deployments: { cert: CKAD, line: "Deployments, rollouts, probes and configuration for applications are what the CKAD tests." },
  helm: { cert: CKAD, line: "Packaging and deploying applications, Helm included, is part of the CKAD." },
  security: {
    cert: CKS,
    line: "Hardening clusters, RBAC, network policies, supply-chain security and runtime security are what the CKS tests.",
    also: CKA,
    note: "The CKS requires a passed CKA.",
  },
};

const pitch = openshift || aiGpu ? undefined : PITCH[category.toLowerCase()];
const trackAttrs = (cert: Cert) => ({
  "data-affiliate": "linux_foundation",
  "data-offer-id": `lf_${cert.id}`,
});
---

{openshift && (
  <aside class="mt-8 mb-4 not-prose" aria-label={OPENSHIFT_REVIEW.title} data-enterprise-offer={OPENSHIFT_REVIEW.offer}>
    <div class="rounded-xl border border-red-200 bg-gradient-to-r from-red-50 to-slate-50 p-6">
      <p class="text-xs uppercase tracking-wider text-red-700 font-semibold mb-2">Running OpenShift in production?</p>
      <p class="text-lg font-bold text-slate-900">Planning an OpenShift 4.x upgrade or facing end of support?</p>
      <p class="text-sm text-slate-700 mt-2 leading-relaxed">{reviewText}</p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <a
          href={reviewUrl}
          target="_blank"
          rel="noopener"
          data-enterprise-cta={OPENSHIFT_REVIEW.offer}
          data-cta-placement="recipe-end"
          class="inline-flex min-h-11 items-center gap-1 rounded-lg bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700"
        >
          See the OpenShift upgrade review →
        </a>
      </div>
      <p class="text-xs text-slate-600 mt-3">
        Open Empower is the consulting company of Luca Berton, co-author of Kubernetes Recipes.
      </p>
    </div>
    {openshiftAi && (
      <div class="group relative mt-3 flex items-center gap-4 rounded-xl border border-slate-200 bg-gradient-to-r from-white to-red-50/60 p-3 pr-4 shadow-sm transition hover:border-red-300 hover:shadow-md">
        <BookCover
          src={ocpAi.cover}
          title={ocpAi.title}
          width={ocpAi.coverWidth}
          height={ocpAi.coverHeight}
          tint="rgba(185,28,28,0.4)"
          class="w-14 shrink-0"
        />
        <div class="min-w-0 flex-1">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-red-700">Ebook by Luca Berton · Leanpub</p>
          <!-- The title link covers the whole card (after:inset-0); the team link sits above it. -->
          <a
            href={leanpubUrl("openshift-ai", slug)}
            target="_blank"
            rel="noopener"
            data-book="openshift-ai"
            data-book-placement="recipe-end"
            class="mt-0.5 flex items-center justify-between gap-3 font-bold leading-snug text-slate-900 after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-red-700"
          >
            <span>{ocpAi.title}</span>
            <span class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-red-700 group-hover:text-red-800">
              <span class="hidden sm:inline">Get the ebook</span><span aria-hidden="true">→</span>
            </span>
          </a>
          <a
            href={leanpubTeamUrl("openshift-ai", "recipe-end")}
            target="_blank"
            rel="noopener"
            data-book="openshift-ai"
            data-book-placement="recipe-end"
            data-book-team
            class="relative z-10 -my-2 inline-block min-h-11 py-3.5 text-xs leading-4 text-red-800 underline decoration-red-300 underline-offset-2 hover:decoration-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700"
          >
            {"Buying for your team? Team packs from 3 copies "}<span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    )}
  </aside>
)}

{aiGpu && (
  <aside class="mt-8 mb-4 not-prose" aria-label="Kubernetes AI ebook and GPU cluster design review" data-enterprise-offer={GPU_REVIEW.offer}>
    <p class="text-xs uppercase tracking-wider text-violet-700 font-semibold mb-3">Running AI and GPU workloads on Kubernetes?</p>
    <div class="grid gap-4 md:grid-cols-2">
      <!-- Ebook: cover, eyebrow, title, pill, blurb, button -->
      <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-violet-200 bg-gradient-to-br from-violet-50 via-white to-sky-50 p-5 shadow-sm">
        <div aria-hidden="true" class="pointer-events-none absolute -left-16 -top-20 h-48 w-48 rounded-full bg-violet-200/50 blur-3xl"></div>
        <div class="relative grid grid-cols-[88px_minmax(0,1fr)] items-center gap-4 lg:grid-cols-[112px_minmax(0,1fr)]">
          <BookCover
            src={k8sAi.cover}
            title={k8sAi.title}
            width={k8sAi.coverWidth}
            height={k8sAi.coverHeight}
            tint="rgba(109,40,217,0.45)"
          />
          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wider text-violet-700">Ebook by Luca Berton</p>
            <p class="mt-1 text-xl font-bold leading-tight text-slate-900">{k8sAi.title}</p>
            <p class="mt-2.5">
              <span class="inline-flex items-center rounded-full border border-violet-200 bg-white/80 px-2.5 py-0.5 text-xs font-medium text-violet-800">Ebook · Leanpub</span>
            </p>
          </div>
        </div>
        <p class="relative mt-4 text-sm leading-relaxed text-slate-700">{k8sAi.description}</p>
        <div class="relative mt-auto pt-4">
          <a
            href={leanpubUrl("kubernetes-ai", slug)}
            target="_blank"
            rel="noopener"
            data-book="kubernetes-ai"
            data-book-placement="recipe-end"
            class="inline-flex min-h-11 w-full items-center justify-center gap-1.5 rounded-lg bg-violet-700 px-5 text-sm font-semibold text-white shadow-[0_6px_16px_-6px_rgba(109,40,217,0.7)] transition hover:bg-violet-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-700 sm:w-auto"
          >
            Get the ebook <span aria-hidden="true">→</span>
          </a>
          <a
            href={leanpubTeamUrl("kubernetes-ai", "recipe-end")}
            target="_blank"
            rel="noopener"
            data-book="kubernetes-ai"
            data-book-placement="recipe-end"
            data-book-team
            class="mt-1 block w-fit min-h-11 py-3 text-sm leading-5 text-violet-800 underline decoration-violet-300 underline-offset-2 hover:decoration-violet-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-700"
          >
            {"Buying for your team? Team packs from 3 copies "}<span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- GPU cluster design review: no cover, dark panel with an icon -->
      <div class="relative flex flex-col overflow-hidden rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-950 p-5 text-white shadow-sm">
        <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-20 h-48 w-48 rounded-full bg-sky-500/20 blur-3xl"></div>
        <div class="relative flex items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-sky-300 ring-1 ring-inset ring-white/15">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="6" y="6" width="12" height="12" rx="2"></rect>
              <rect x="9.5" y="9.5" width="5" height="5" rx="1"></rect>
              <path d="M9 2.5v3M15 2.5v3M9 18.5v3M15 18.5v3M2.5 9h3M2.5 15h3M18.5 9h3M18.5 15h3"></path>
            </svg>
          </span>
          <p class="text-xs font-semibold uppercase tracking-wider text-sky-300">Consulting by Luca Berton</p>
        </div>
        <p class="relative mt-3 text-xl font-bold leading-tight">{GPU_REVIEW.title}</p>
        <p class="relative mt-2 text-sm leading-relaxed text-slate-300">Buying rack-scale GPUs? An independent review of the fabric, management plane and operations design, delivered in writing before the purchase order goes out.</p>
        <p class="relative mt-3 border-t border-white/10 pt-3 text-sm font-semibold text-white">{GPU_REVIEW.terms}</p>
        <div class="relative mt-auto pt-4">
          <a
            href={gpuReviewUrl(slug)}
            target="_blank"
            rel="noopener"
            data-enterprise-cta={GPU_REVIEW.offer}
            data-cta-placement="recipe-end"
            class="inline-flex min-h-11 w-full items-center justify-center gap-1.5 rounded-lg bg-white px-5 text-sm font-semibold text-slate-900 transition hover:bg-sky-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"
          >
            See the GPU cluster review <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
    <p class="text-xs text-slate-600 mt-3">
      Both by Luca Berton, co-author of Kubernetes Recipes.
    </p>
  </aside>
)}

{pitch && (
  <aside class="mt-8 mb-4 not-prose" aria-label={`${pitch.cert.short} certification`} data-cert-cta={pitch.cert.id}>
    <div class="rounded-xl border border-emerald-200 bg-gradient-to-r from-emerald-50 to-sky-50 p-6">
      <p class="text-xs uppercase tracking-wider text-emerald-700 font-semibold mb-2">🎓 Turn this skill into a certification</p>
      <p class="text-lg font-bold text-slate-900">{pitch.cert.name} ({pitch.cert.short})</p>
      <p class="text-sm text-slate-700 mt-2 leading-relaxed">
        {pitch.line} The exam is online, proctored and hands-on: 2 hours of tasks in a live cluster, with Killer.sh simulator sessions to practise first.{pitch.note && ` ${pitch.note}`}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <a
          href={pitch.cert.url}
          target="_blank"
          rel="sponsored noopener"
          {...trackAttrs(pitch.cert)}
          class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors"
        >
          See the {pitch.cert.short} exam →
        </a>
        {pitch.also && (
          <a
            href={pitch.also.url}
            target="_blank"
            rel="sponsored noopener"
            {...trackAttrs(pitch.also)}
            class="text-sm font-semibold text-emerald-700 hover:text-emerald-800 underline"
          >
            Start with the {pitch.also.short}
          </a>
        )}
      </div>
      <p class="text-xs text-slate-600 mt-3">
        Affiliate link: Kubernetes Recipes earns a commission from the Linux Foundation if you buy, at no extra cost to you.
      </p>
    </div>
  </aside>
)}
