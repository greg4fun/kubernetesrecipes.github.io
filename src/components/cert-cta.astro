---
/**
 * Linux Foundation certification box at the end of a recipe.
 *
 * Kubernetes readers are the people who sit the CKA, CKAD and CKS, so each
 * recipe category points to the exam that tests the same skills. Links go
 * through the Awin affiliate programme (Linux Foundation, merchant 85919):
 * the site earns a commission on purchases, so the box carries a disclosure
 * and rel="sponsored". AI/GPU recipes get the box below instead: no LF exam
 * matches them.
 *
 * Clicks fire the GA4 event affiliate_click (see Layout.astro).
 *
 * OpenShift recipes (src/utils/openshift.mjs: slug, title or tags) show the
 * Open Empower OpenShift upgrade review instead, whatever their category. That
 * link is our own offer, so it has no data-affiliate and no rel="sponsored";
 * its clicks fire enterprise_cta_click (offer, placement). OpenShift recipes
 * about AI/GPU workloads add one line for the OpenShift AI ebook on Leanpub.
 *
 * Other AI/GPU recipes (src/utils/ai-gpu.mjs) show two of Luca's own offers:
 * the Kubernetes AI ebook on Leanpub (book_click: book, placement) and the GPU
 * cluster design review (enterprise_cta_click: offer, placement). Order of
 * precedence and the matching rules: src/utils/ai-gpu.mjs.
 */
import { OPENSHIFT_REVIEW, isOpenShiftRecipe, openShiftReviewUrl } from "../utils/openshift.mjs";
import {
  GPU_REVIEW,
  LEANPUB_BOOKS,
  gpuReviewUrl,
  isAiGpuRecipe,
  isOpenShiftAiRecipe,
  leanpubUrl,
} from "../utils/ai-gpu.mjs";

export interface Props {
  category?: string;
  slug?: string;
  title?: string;
  tags?: string[];
}

const { category = "", slug = "", title = "", tags = [] } = Astro.props;

const recipe = { category, slug, title, tags };
const openshift = isOpenShiftRecipe(recipe);
const openshiftAi = openshift && isOpenShiftAiRecipe(recipe);
const aiGpu = !openshift && isAiGpuRecipe(recipe);
const k8sAi = LEANPUB_BOOKS["kubernetes-ai"];
const ocpAi = LEANPUB_BOOKS["openshift-ai"];
const reviewUrl = openShiftReviewUrl(slug);
// One string, so the HTML minifier cannot drop the spaces between the parts.
const reviewText = `A fixed-price ${OPENSHIFT_REVIEW.price} engagement by Open Empower: a written review of your cluster and upgrade path, plus a 90-minute call to go through it with your team.`;

const AWIN = "https://www.awin1.com/cread.php?awinmid=85919&awinaffid=1937397&ued=";
const lf = (path: string) =>
  AWIN + encodeURIComponent(`https://training.linuxfoundation.org/certification/${path}/`);

interface Cert {
  id: string;
  name: string;
  short: string;
  url: string;
}

const CKA: Cert = { id: "cka", name: "Certified Kubernetes Administrator", short: "CKA", url: lf("certified-kubernetes-administrator-cka") };
const CKAD: Cert = { id: "ckad", name: "Certified Kubernetes Application Developer", short: "CKAD", url: lf("certified-kubernetes-application-developer-ckad") };
const CKS: Cert = { id: "cks", name: "Certified Kubernetes Security Specialist", short: "CKS", url: lf("certified-kubernetes-security-specialist") };

interface Pitch {
  cert: Cert;
  line: string;
  also?: Cert;
  note?: string;
}

const PITCH: Record<string, Pitch> = {
  troubleshooting: { cert: CKA, line: "Fixing a broken cluster under time pressure is exactly what the CKA tests, along with networking, storage and cluster configuration." },
  networking: { cert: CKA, line: "Services, ingress, DNS and network policies are core CKA skills, along with troubleshooting, storage and cluster configuration." },
  storage: { cert: CKA, line: "Persistent volumes, claims and storage classes are part of the CKA, along with troubleshooting, networking and cluster configuration." },
  configuration: { cert: CKA, line: "Cluster configuration, workloads and troubleshooting from the command line are what the CKA tests." },
  autoscaling: { cert: CKA, line: "Scheduling, scaling and keeping workloads healthy are part of the CKA, along with troubleshooting and networking." },
  observability: { cert: CKA, line: "Reading logs, events and metrics to find a fault is a large part of the CKA's troubleshooting tasks." },
  deployments: { cert: CKAD, line: "Deployments, rollouts, probes and configuration for applications are what the CKAD tests." },
  helm: { cert: CKAD, line: "Packaging and deploying applications, Helm included, is part of the CKAD." },
  security: {
    cert: CKS,
    line: "Hardening clusters, RBAC, network policies, supply-chain security and runtime security are what the CKS tests.",
    also: CKA,
    note: "The CKS requires a passed CKA.",
  },
};

const pitch = openshift || aiGpu ? undefined : PITCH[category.toLowerCase()];
const trackAttrs = (cert: Cert) => ({
  "data-affiliate": "linux_foundation",
  "data-offer-id": `lf_${cert.id}`,
});
---

{openshift && (
  <aside class="mt-8 mb-4 not-prose" aria-label={OPENSHIFT_REVIEW.title} data-enterprise-offer={OPENSHIFT_REVIEW.offer}>
    <div class="rounded-xl border border-red-200 bg-gradient-to-r from-red-50 to-slate-50 p-6">
      <p class="text-xs uppercase tracking-wider text-red-700 font-semibold mb-2">Running OpenShift in production?</p>
      <p class="text-lg font-bold text-slate-900">Planning an OpenShift 4.x upgrade or facing end of support?</p>
      <p class="text-sm text-slate-700 mt-2 leading-relaxed">{reviewText}</p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <a
          href={reviewUrl}
          target="_blank"
          rel="noopener"
          data-enterprise-cta={OPENSHIFT_REVIEW.offer}
          data-cta-placement="recipe-end"
          class="inline-flex items-center gap-1 rounded-lg bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800 transition-colors"
        >
          See the OpenShift upgrade review →
        </a>
      </div>
      {openshiftAi && (
        <p class="text-sm text-slate-700 mt-3">
          Read: <a
            href={leanpubUrl("openshift-ai", slug)}
            target="_blank"
            rel="noopener"
            data-book="openshift-ai"
            data-book-placement="recipe-end"
            class="font-semibold text-red-700 hover:text-red-800 underline"
          >{ocpAi.title}</a> (ebook, Leanpub)
        </p>
      )}
      <p class="text-xs text-slate-600 mt-3">
        Open Empower is the consulting company of Luca Berton, co-author of Kubernetes Recipes.
      </p>
    </div>
  </aside>
)}

{aiGpu && (
  <aside class="mt-8 mb-4 not-prose" aria-label="Kubernetes AI ebook and GPU cluster design review" data-enterprise-offer={GPU_REVIEW.offer}>
    <div class="rounded-xl border border-violet-200 bg-gradient-to-r from-violet-50 to-sky-50 p-6">
      <p class="text-xs uppercase tracking-wider text-violet-700 font-semibold mb-3">Running AI and GPU workloads on Kubernetes?</p>
      <div class="grid gap-5 md:grid-cols-2">
        <div>
          <p class="text-lg font-bold text-slate-900">{k8sAi.title} <span class="text-sm font-normal text-slate-600">(ebook)</span></p>
          <p class="text-sm text-slate-700 mt-1 leading-relaxed">{k8sAi.description}</p>
          <a
            href={leanpubUrl("kubernetes-ai", slug)}
            target="_blank"
            rel="noopener"
            data-book="kubernetes-ai"
            data-book-placement="recipe-end"
            class="mt-3 inline-flex items-center gap-1 rounded-lg bg-violet-700 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800 transition-colors"
          >
            Get the ebook on Leanpub →
          </a>
        </div>
        <div>
          <p class="text-lg font-bold text-slate-900">GPU cluster design review</p>
          <p class="text-sm text-slate-700 mt-1 leading-relaxed">Buying rack-scale GPUs? An independent review of the fabric, management plane and operations design, delivered in writing before the purchase order goes out.</p>
          <p class="text-sm font-semibold text-slate-900 mt-1">{GPU_REVIEW.terms}</p>
          <a
            href={gpuReviewUrl(slug)}
            target="_blank"
            rel="noopener"
            data-enterprise-cta={GPU_REVIEW.offer}
            data-cta-placement="recipe-end"
            class="mt-3 inline-flex items-center gap-1 rounded-lg border-2 border-violet-700 bg-white px-4 py-2 text-sm font-semibold text-violet-800 hover:bg-violet-50 transition-colors"
          >
            See the GPU cluster review →
          </a>
        </div>
      </div>
      <p class="text-xs text-slate-600 mt-4">
        Both by Luca Berton, co-author of Kubernetes Recipes.
      </p>
    </div>
  </aside>
)}

{pitch && (
  <aside class="mt-8 mb-4 not-prose" aria-label={`${pitch.cert.short} certification`} data-cert-cta={pitch.cert.id}>
    <div class="rounded-xl border border-emerald-200 bg-gradient-to-r from-emerald-50 to-sky-50 p-6">
      <p class="text-xs uppercase tracking-wider text-emerald-700 font-semibold mb-2">🎓 Turn this skill into a certification</p>
      <p class="text-lg font-bold text-slate-900">{pitch.cert.name} ({pitch.cert.short})</p>
      <p class="text-sm text-slate-700 mt-2 leading-relaxed">
        {pitch.line} The exam is online, proctored and hands-on: 2 hours of tasks in a live cluster, with Killer.sh simulator sessions to practise first.{pitch.note && ` ${pitch.note}`}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <a
          href={pitch.cert.url}
          target="_blank"
          rel="sponsored noopener"
          {...trackAttrs(pitch.cert)}
          class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors"
        >
          See the {pitch.cert.short} exam →
        </a>
        {pitch.also && (
          <a
            href={pitch.also.url}
            target="_blank"
            rel="sponsored noopener"
            {...trackAttrs(pitch.also)}
            class="text-sm font-semibold text-emerald-700 hover:text-emerald-800 underline"
          >
            Start with the {pitch.also.short}
          </a>
        )}
      </div>
      <p class="text-xs text-slate-600 mt-3">
        Affiliate link: Kubernetes Recipes earns a commission from the Linux Foundation if you buy, at no extra cost to you.
      </p>
    </div>
  </aside>
)}
